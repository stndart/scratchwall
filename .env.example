PUBLIC_BASE_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
PORT=8080
DATA_PATH=./data
# Confidential OIDC client; see README.md.
OIDC_ISSUER=https://auth.example.com/oidc
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
OIDC_GROUPS_CLAIM=groups
OIDC_ALLOWED_GROUPS=scratchwall
SESSION_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
MAX_ATTACHMENT_BYTES=2147483648
# Optional: shared secret for the separate scratchbot plugin.
INGEST_TOKEN=
# Optional self-hosted semantic search. Start with --profile embeddings.
# Set a random token of at least 32 characters on both server and worker.
EMBEDDING_URL=
EMBEDDING_TOKEN=
EMBEDDING_THREADS=2
EMBEDDING_CPUS=2
EMBEDDING_MEMORY=8g
RUST_LOG=scratchwall_server=info,tower_http=info
