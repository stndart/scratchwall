{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scratchwall",
  "version": "0.1.0",
  "identifier": "org.scratchwall.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scratchwall",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:8080 ws://localhost:8080; img-src 'self' data: blob: http://localhost:8080; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "android": { "minSdkVersion": 29 },
    "linux": { "appimage": { "bundleMediaFramework": false } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["scratchwall"] },
      "mobile": [{ "scheme": ["scratchwall"], "appLink": false }]
    },
    "sql": { "preload": ["sqlite:scratchwall.sqlite"] }
  }
}
